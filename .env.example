# ---- 앱 ----
APP_ENV=local
LOG_LEVEL=INFO
# 카카오 카드 버튼이 가리킬 우리 서버의 공개 주소 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8000

# ---- Supabase ----
# 비워두면 DB 없이(no-op 로깅 모드) 그대로 동작한다. 카카오 응답 확인용으로 유용.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 애드픽 ----
# 애드픽 링크에 서브 파라미터를 실을 수 있으면 click_id를 붙여 전환 매칭에 사용
ADPICK_SUBID_PARAM=subid
ADPICK_DEFAULT_URL=

# ---- 보안(선택) ----
# 값을 넣으면 카카오 스킬 요청 헤더 X-Skill-Token 검증. 비우면 검증 안 함.
KAKAO_SKILL_TOKEN=

# ---- 호텔 provider ----
# static | (추후) ai, crawler
HOTEL_PROVIDER=static
HOTEL_RESULT_LIMIT=5
