# ---- 앱 ----
APP_ENV=local
LOG_LEVEL=INFO

# 카카오 카드 버튼이 가리킬 우리 서버의 공개 주소 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8000

# 배포용. Caddy 인증서 발급 도메인 (docker-compose)
DOMAIN=

# ---- Supabase ----
# 비워두면 DB 없이(no-op 로깅 모드) 그대로 동작한다. 카카오 응답 확인용으로 유용.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 애드픽 ----
# 커미션 링크 생성 API: GET {BASE}/api/{KEY}/link?url=...
# 키가 비어 있으면 ADPICK_LINK_TEMPLATE 로, 그것도 비면 원본 주소로 폴백한다.
ADPICK_API_BASE=https://biz.adpick.co.kr
ADPICK_API_KEY=
ADPICK_TIMEOUT_SECONDS=2.0

# true: 링크만 반환(분당 60회, 빠름) / false: 상품정보 포함(분당 10회, 느리고 실패 가능)
ADPICK_LINKONLY=true
# rate limit 대비 동시 호출 상한
ADPICK_MAX_CONCURRENCY=5

# API 키 없이 테스트할 때 쓸 폴백 템플릿. {source_url}(URL 인코딩됨), {click_id} 치환.
ADPICK_LINK_TEMPLATE=

# 변환 결과 재사용 기간(일). 0 이면 무기한.
# 애드픽은 180일간 클릭 없는 링크를 삭제할 수 있으므로 그보다 짧게 두는 게 안전하다.
ADPICK_LINK_TTL_DAYS=30

# 최종 링크에 click_id 를 붙일 파라미터명.
# 애드픽 커미션 링크는 이 파라미터를 해석하지 않는다(p_data 가 그 역할). 기본 비활성.
ADPICK_SUBID_PARAM=

# ---- 보안(선택) ----
# 값을 넣으면 카카오 스킬 요청 헤더 X-Skill-Token 검증. 비우면 검증 안 함.
KAKAO_SKILL_TOKEN=
# 카카오 콜백 POST 타임아웃(초). 카카오는 콜백을 1분 안에 받는다.
KAKAO_CALLBACK_TIMEOUT_SECONDS=10

# 진단 엔드포인트 /api/v1/debug/hotel-search 보호.
# 호출 한 번이 곧 OpenAI 요금인데 /docs 는 공개돼 있으므로 운영에서는 반드시 채운다.
# 비워두면: 로컬은 그냥 열리고, APP_ENV=production 이면 404.
DEBUG_TOKEN=

# ---- OpenAI ----
# ⚠️ 비어 있으면 호텔 검색이 통째로 동작하지 않는다 (빈 결과 → "찾지 못했어요").
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# ⚠️ 403 "does not have access to model" 이 나면 여기부터 의심한다.
#    레거시 sk- 키는 조직의 **기본 프로젝트**로 붙는다. 대시보드에서 다른 프로젝트의
#    Allowed models 를 고쳐놨다면 그 설정이 안 먹는다. 원하는 프로젝트 ID 를 넣으면 된다.
#    sk-proj- 키는 프로젝트가 키에 박혀 있으므로 비워둔다.
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
# ⚠️ 검색용 모델. gpt-5-nano 는 web_search 를 제대로 못 써서 결과 대신
#    "진행해도 될까요?" 같은 문장을 낸다. mini 이상을 쓴다.
OPENAI_MODEL=gpt-5-mini
# 웹 검색이 붙은 호출은 느리다. 5초 예산은 캐시가 지키므로 넉넉히 준다.
OPENAI_TIMEOUT_SECONDS=60
# gpt-5 계열 reasoning.effort: minimal | low | medium | high
# 올릴수록 결과가 좋아지지만 느려지고 비싸진다. 콜백 예산은 1분이다.
OPENAI_SEARCH_EFFORT=low
OPENAI_RANK_EFFORT=low
# 1차 호출에서 모을 후보 수. 여기서 추려 RESULT_MAX_ITEMS 개만 남긴다.
# ⚠️ RESULT_MAX_ITEMS(기본 20)보다 넉넉히 커야 2차 호출이 "고르는" 일을 한다.
#    같거나 작으면 후보를 전부 쓰게 되어 선별이 사실상 안 돈다 (부팅 때 경고가 뜬다).
OPENAI_CANDIDATE_COUNT=30

# ---- 발화 해석 ----
# "오사카 호텔 4명 9월 22~24일 추천해줘"
#   → { intent: hotel, place: 오사카, ignored: ["4명", "9월 22~24일"] }
#
# ⚠️ 이 호출만 카카오 5초 예산 안에서 돈다. 검색용 모델과 분리한 이유가 그것이다 —
#    검색은 품질이 중요하고 콜백 예산(1분)을 쓰지만, 파싱은 속도가 곧 품질이다.
OPENAI_PARSE_MODEL=gpt-5-nano
OPENAI_PARSE_EFFORT=minimal
# 늦으면 포기하고 도움말/되묻기로 떨어진다. 5초를 넘겨 아무것도 못 주는 것보다 낫다.
# 무엇이 일어났는지는 /api/v1/debug/parse 로 확인한다.
OPENAI_PARSE_TIMEOUT_SECONDS=4
# 같은 문장을 두 번 해석하지 않는다. 단톡방은 같은 말이 반복된다.
INTENT_CACHE_TTL_MINUTES=10080
# 지역 별칭 캐시("동경"→도쿄). 0 이면 매 메시지가 유료가 된다.
NLU_ALIAS_TTL_MINUTES=1440

# ------------------------------------------------------------------ 결과·캐시
# 한 번의 검색으로 저장하는 최대 건수. 5건씩 잘라 최대 4페이지로 낸다.
# ⚠️ "한 카드에 몇 줄" 이 아니라 "몇 개를 찾아 들고 있을지" 다. 5 이하면 넘길 게
#    없어서 "더 보기" 버튼이 아예 안 달린다 (부팅 때 경고가 뜬다).
RESULT_MAX_ITEMS=20
# 검색이 실패하거나 빈손이었던 걸 기억하는 시간. 길면 일시적 장애가 그만큼 굳는다.
# (한 번 빈손은 1분만 굳힌다 — 모델은 같은 질의에도 가끔 빈손으로 돌아온다)
FAILED_TTL_MINUTES=10
# pending 을 꽂아둔 채 죽은 검색을 다른 요청이 되찾아가기까지의 시간.
PENDING_TIMEOUT_SECONDS=120

# ---- 호텔 provider ----
# openai — gpt-5-mini + 웹 검색
HOTEL_PROVIDER=openai
# 호텔 요금은 하루 사이에도 바뀐다. 하루가 변동과 AI 호출 비용의 타협점이다.
HOTEL_CACHE_TTL_MINUTES=1440

# ---- 카드 썸네일 ----
# 예약 페이지를 직접 읽어 대표 이미지를 뽑는다 (og:image → JSON-LD → 본문 사진 순).
# 모델에게 시키면 없는 CDN 주소를 지어내므로, 페이지에서 읽는 게 유일한 방법이다.
# 콜백 경로에서만 도는 코드라 카카오 5초 예산과 무관하다.
# 끄면 카드가 글자만 남는다 (동작에는 문제 없다).
HOTEL_THUMBNAILS=true
HOTEL_THUMBNAIL_TIMEOUT_SECONDS=4
# 예약 페이지 앞부분만 읽는다. 이미지 주소는 앞쪽에 있으므로 다 받을 이유가 없다.
HOTEL_THUMBNAIL_MAX_KB=512

# ---- 항공권 provider ----
# openai — gpt-5-mini + 웹 검색 (호텔과 같은 2단 구조)
#
# ⚠️ 실시간 운임 API 가 아니다. 웹 검색으로 "그 노선이 대략 얼마인가"를 얻는 것이라
#    카드에는 '예상가' 로 나가고 안내 말풍선에도 그렇게 적힌다. 실제 금액은
#    예약 페이지에서 확정된다. GDS/항공사 API 가 붙으면 provider 만 갈아끼우면 된다.
FLIGHT_PROVIDER=openai
# 항공 운임은 하루에도 몇 번 바뀐다. 호텔(24시간)보다 짧게 잡는다.
# ⚠️ 날짜는 검색에 반영되지 않는다 — 캐시를 노선·왕복여부로만 가르기 때문이다.
#    대신 카드 아래 안내에 "날짜는 반영되지 않았어요" 가 항상 붙는다.
FLIGHT_CACHE_TTL_MINUTES=360
# "오사카 항공권" 처럼 출발지를 안 말하는 게 보통이다. 되묻는 대신 여기서 출발한다고
# 보고, 안내 말풍선에 "서울 출발 기준" 을 적어 고쳐 말할 수 있게 한다.
FLIGHT_DEFAULT_ORIGIN_NAME=서울
FLIGHT_DEFAULT_ORIGIN_CODE=ICN
# ⚠️ 항공권도 listCard 다. 설정이 아니라 고정이다 —
#    **그룹챗봇(팀톡방)은 itemCard 를 못 그린다. 말풍선이 통째로 사라진다.**

# ------------------------------------------------------------------ 더 보기
# 한 번 찾은 RESULT_MAX_ITEMS 건을 5줄씩 잘라 낸다. 2페이지를 위해 AI 를 다시
# 부르지 않는다 — 더보기는 **AI 호출 0회**가 전제다.
#
# 버튼 방식:
#   block   — clientExtra 로 cache_key·offset 을 실어 보낸다. 서버가 상태를 안 들어도 된다
#   message — 평범한 메시지 버튼. 커서를 못 실으므로 서버가 발화자별로 잠깐 기억한다
# ⚠️ 그룹챗방에서 action:'block' 이 되는지 확인되지 않았다 (itemCard 가 안 됐던 전례).
#    버튼을 눌렀는데 아무 반응이 없으면 message 로 내려라.
MORE_BUTTON_STYLE=block
# 더보기 버튼이 부를 블록 = 폴백 블록.
# ⚠️ **비워두는 게 정상이다.** 비면 요청이 알려준 블록 ID(userRequest.block.id)를 쓴다 —
#    라우터로 들어온 요청은 곧 폴백 블록이 부른 요청이므로 그게 정답이고, 블록을 다시
#    만들어 ID 가 바뀌어도 저절로 따라간다. 다른 블록을 부르고 싶을 때만 채운다.
KAKAO_BLOCK_ID_FALLBACK=

# ---- 관광지 provider ----
# openai — gpt-5-mini + 웹 검색 (호텔·항공권과 같은 2단 구조)
#
# 예약이 없는 도메인이라 애드픽을 타지 않는다. 줄 링크의 목적지는
# **관광지 이름 + 도시로 서버가 만든 구글맵 주소**다 (모델이 준 URL 이 아니다).
# 그래서 허용 호스트 목록도, 링크 검증도 필요 없다.
ATTRACTION_PROVIDER=openai
# 호텔(24시간)·항공권(6시간)보다 훨씬 길다. 요금과 운임은 시시각각 바뀌지만
# **오사카의 볼거리는 어제와 오늘이 같다.** 짧게 잡을수록 같은 답을 다시 사는 셈이다.
ATTRACTION_CACHE_TTL_MINUTES=43200
# 카드 썸네일을 위키백과에서 찾는다 (키 불필요·무료).
# 끄면 사진 없는 예전 카드로 돌아간다. 관광지에는 긁어올 예약 페이지가 없어서
# 호텔처럼 og:image 를 읽을 수 없고, 모델에게 시키면 없는 주소를 지어낸다.
# ⚠️ 전부 채워지지는 않는다 — 실측 87%. 나머지는 그 줄만 사진 없이 나간다.
ATTRACTION_IMAGES=true
# 관광지 5곳을 동시에 찾는다. 콜백 경로라 5초 예산과 무관하지만, 하나가 늘어지면
# 카드 전체가 그만큼 늦으므로 짧게 끊는다.
ATTRACTION_IMAGE_TIMEOUT_SECONDS=3

# (캐시 TTL 은 도메인마다 따로다 — HOTEL_/FLIGHT_/ATTRACTION_CACHE_TTL_MINUTES)
