# travel-chatbot-app — 환경변수
#
# cp .env.example .env  하면 **Supabase·OpenAI 없이도 그대로 뜬다** (no-op 모드).
# 카카오 응답 모양만 확인할 때 유용하다.
#
# 읽는 방법 세 가지를 알아두면 헷갈리지 않는다.
#   1. 여기 적힌 값은 **코드 기본값과 같다.** 그래서 줄을 지워도 동작이 안 바뀐다.
#      바꾸고 싶은 줄만 남기는 편이 운영에서 사고가 적다.
#   2. **서버의 .env 는 배포가 건드리지 않는다.** git reset --hard 는 추적 파일만
#      되돌리고 .env 는 gitignore 다 — 코드 기본값을 올려도 서버에 옛 값이 있으면
#      그게 이긴다. 그래서 부팅 로그에 **실효값**을 찍는다.
#   3. 여기 없는 이름은 **아무도 안 읽는다.** 읽지 않는 knob 이 남아 있으면 사람이
#      그걸 돌려보며 원인을 찾는다 (HOTEL_PROVIDER=static 이 실제로 그랬다).

# ==========================================================================
# 1. 앱
# ==========================================================================
# local | production. /health 에 그대로 찍힌다.
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR.
# ⚠️ Nest 앱을 만들기 전에 필요해서 main.ts 가 process.env 로 직접 읽는다.
LOG_LEVEL=INFO
# 컨테이너가 들을 포트. docker-compose 가 8000 을 박아 넣으므로 보통 건드리지 않는다.
PORT=8000

# **카드 줄 링크의 뿌리다.** 모든 링크가 {PUBLIC_BASE_URL}/r/{clickId} 로 나간다.
# ⚠️ 운영에 로컬 값이 들어가면 카드는 멀쩡해 보이는데 클릭이 전부 죽는다.
PUBLIC_BASE_URL=http://localhost:8000

# 진단 엔드포인트(/api/v1/debug/*) 보호.
# ⚠️ **비워두면 그 경로는 404 다.** 401 이 아니라 404 인 이유 — 401 을 주면
#    "토큰만 알면 열린다" 는 사실이 새어 나간다.
# 호출 한 번이 곧 OpenAI 요금이고 /docs 는 공개돼 있으므로 운영에서는 반드시 채운다.
DEBUG_TOKEN=

# ==========================================================================
# 2. Supabase
# ==========================================================================
# 비워두면 DB 없이(no-op) 돈다 — 앱은 죽지 않고 적재만 건너뛴다.
# 리다이렉트도 인메모리 폴백으로 계속 동작한다.
#
# ⚠️ **마이그레이션은 배포에 포함돼 있지 않다.** supabase/migrations/*.sql 을
#    SQL Editor 에 직접 붙여넣어야 한다 (0001 → 0002 → 0003 → 0004 순, 재실행 안전).
#    빠뜨리면 /health/db 가 어느 파일을 실행해야 하는지 알려준다.
SUPABASE_URL=
# ⚠️ 최상위 위험값 — RLS 를 우회한다. anon/publishable 키가 아니라
#    Settings → API Keys 의 secret(sb_secret_...) 또는 Legacy 탭의 service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================================================
# 3. 카카오
# ==========================================================================
# 오픈빌더 스킬에 등록한 X-Skill-Token 헤더 값.
# 비워두면 검증하지 않는다(로컬용). 운영에서 비우면 스킬 URL 을 아무나 호출한다.
KAKAO_SKILL_TOKEN=
# 콜백 POST 타임아웃(초). 카카오는 콜백을 1분 안에 받는다.
KAKAO_CALLBACK_TIMEOUT_SECONDS=10

# "더 보기" 버튼 방식: block | message
#   block   — clientExtra 로 cache_key·offset 을 실어 보낸다. 서버가 상태를 안 들어도 된다
#   message — 평범한 메시지 버튼. 커서를 못 실으므로 서버가 발화자별로 30분 기억한다
# ⚠️ 그룹챗방에서 action:'block' 이 되는지 확인되지 않았다 (itemCard 가 안 됐던 전례).
#    버튼을 눌렀는데 반응이 없으면 message 로 내려라.
MORE_BUTTON_STYLE=block
# 더보기 버튼이 부를 블록 = 폴백 블록.
# ⚠️ **비워두는 게 정상이다.** 비면 요청이 알려준 블록 ID(userRequest.block.id)를 쓴다 —
#    라우터를 부른 게 곧 폴백 블록이므로 그게 정답이고, 블록을 다시 만들어 ID 가
#    바뀌어도 저절로 따라간다. 다른 블록을 부르고 싶을 때만 채운다.
KAKAO_BLOCK_ID_FALLBACK=

# ==========================================================================
# 4. OpenAI — 검색 (콜백 예산 1분 안에서 돈다)
# ==========================================================================
# ⚠️ 비어 있으면 검색이 통째로 빈손이 된다 ("지금은 정리하지 못했어요").
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ⚠️ **gpt-5-nano 를 쓰면 안 된다.** web_search 를 제대로 못 써서 결과 대신
#    "진행해도 될까요?" 같은 문장을 낸다. mini 이상.
OPENAI_MODEL=gpt-5-mini
# 웹 검색이 붙은 호출은 7~30초다. 5초 예산은 저장된 결과가 지키므로 넉넉히 준다.
OPENAI_TIMEOUT_SECONDS=60
# gpt-5 계열 reasoning.effort: minimal | low | medium | high
# 올릴수록 좋아지지만 느려지고 비싸진다. 콜백 예산이 1분이다.
OPENAI_SEARCH_EFFORT=low
OPENAI_RANK_EFFORT=low
# 1차 호출에서 모을 후보 수. 2차 호출이 여기서 RESULT_MAX_ITEMS 개를 고른다.
# ⚠️ RESULT_MAX_ITEMS(20)보다 넉넉히 커야 "고르는" 일이 일어난다. 같거나 작으면
#    후보를 전부 써야 해서 선별이 사실상 안 돌고, 부팅 때 경고가 뜬다.
OPENAI_CANDIDATE_COUNT=30

# 레거시 sk- 키는 조직의 **기본 프로젝트**로 붙는다. 다른 프로젝트에서 모델을
# 허용해뒀다면 그 설정이 안 먹고 403 이 난다. sk-proj- 키는 비워두면 된다.
OPENAI_PROJECT=
OPENAI_ORGANIZATION=

# ==========================================================================
# 5. OpenAI — 발화 해석 (카카오 5초 예산 안에서 도는 유일한 호출)
# ==========================================================================
# "오사카 호텔 4명 9월 22~24일 추천해줘"
#   → { intent: hotel, place: 오사카, ignored: ["4명", "9월 22~24일"] }
#
# 검색용 모델과 분리한 이유: 검색은 품질이 중요하고 1분을 쓰지만, 해석은
# **속도가 곧 품질**이다. 늦으면 도움말/되묻기로 떨어진다.
# (사전에 있는 도시 + 키워드면 이 호출 자체가 없다 — "오사카 호텔 추천해줘" 는 0원)
OPENAI_PARSE_MODEL=gpt-5-nano
OPENAI_PARSE_EFFORT=minimal
# 넘기면 포기한다. 5초를 넘겨 아무것도 못 주는 것보다 낫다.
# 무슨 일이 있었는지는 /api/v1/debug/parse 로 확인한다.
OPENAI_PARSE_TIMEOUT_SECONDS=4
# 같은 문장을 두 번 해석하지 않는다. 단톡방은 같은 말이 반복된다 (7일).
# (지역 별칭 캐시에는 TTL 이 없다 — "동경"→도쿄 는 시간이 지나도 변하지 않는다)
INTENT_CACHE_TTL_MINUTES=10080

# ==========================================================================
# 6. 결과 · 캐시
# ==========================================================================
# 한 번의 검색으로 저장하는 최대 건수. 5건씩 잘라 최대 4페이지로 낸다.
# ⚠️ "한 카드에 몇 줄" 이 아니라 "몇 개를 찾아 들고 있을지" 다. 5 이하면 넘길 게
#    없어서 "더 보기" 버튼이 아예 안 달린다 (부팅 때 경고가 뜬다).
# ⚠️ 올릴수록 AI 가 뒤쪽 항목을 지어낼 여지가 커진다. 품질이 떨어지면 10~15 로.
RESULT_MAX_ITEMS=20

# 캐시 TTL 은 도메인마다 다르다. **무엇이 얼마나 빨리 상하는가**가 기준이다.
#   호텔 요금   하루 사이에도 바뀐다
#   항공 운임   하루에도 몇 번 바뀐다
#   볼거리      어제와 오늘이 같다 — 짧게 잡을수록 같은 답을 다시 사는 셈이다
HOTEL_CACHE_TTL_MINUTES=1440
FLIGHT_CACHE_TTL_MINUTES=360
ATTRACTION_CACHE_TTL_MINUTES=43200

# 검색이 실패하거나 빈손이었던 걸 기억하는 시간. 길면 일시적 장애가 그만큼 굳는다.
# (한 번 빈손은 1분만 굳힌다 — 모델은 같은 질의에도 가끔 빈손으로 돌아온다.
#  한 번에 10분을 굳혔더니 "도쿄 호텔" 이 10분짜리 장애가 된 적이 있다)
FAILED_TTL_MINUTES=10
# pending 을 꽂아둔 채 죽은 검색을 다른 요청이 되찾아가기까지의 시간.
# 검색은 보통 7~30초다. 그보다 넉넉히 잡되, 프로세스가 죽었을 때 그 지역을 영영
# 아무도 못 물어보는 일은 없어야 한다.
PENDING_TIMEOUT_SECONDS=120

# ==========================================================================
# 7. 애드픽 (제휴 링크)
# ==========================================================================
# 원본 예약 주소 → 커미션 링크: GET {BASE}/api/{KEY}/link?url=...
# 키가 비면 ADPICK_LINK_TEMPLATE 로, 그것도 비면 원본 주소로 폴백한다 —
# **수익화는 못 해도 사용자는 호텔을 본다.**
ADPICK_API_BASE=https://biz.adpick.co.kr
# ⚠️ 키가 URL 경로에 들어간다. 예외 메시지에 요청 URL 이 담기므로 로그에 그대로
#    찍히지 않도록 adpick.service.ts 의 redact() 가 *** 로 가린다.
ADPICK_API_KEY=
ADPICK_TIMEOUT_SECONDS=2.0
# true 면 분당 60회, false 면 10회 (애드픽 제한). 링크만 필요하면 true 가 맞다.
ADPICK_LINKONLY=true
ADPICK_MAX_CONCURRENCY=5
# 키 없이 테스트할 때 쓰는 형식. {source_url} 자리에 원본 주소가 들어간다.
ADPICK_LINK_TEMPLATE=
# 180일간 클릭 없는 링크는 삭제될 수 있다. 그 안에서 재사용한다.
ADPICK_LINK_TTL_DAYS=30
# 커미션 링크는 임의 파라미터를 해석하지 않는다(p_data 가 그 역할). 기본 비활성.
ADPICK_SUBID_PARAM=

# ==========================================================================
# 8. 카드 이미지
# ==========================================================================
# 호텔: 예약 페이지를 직접 읽어 대표 이미지를 뽑는다 (og:image → JSON-LD → 본문 사진).
# ⚠️ 모델에게 시키면 없는 CDN 주소를 지어낸다 — web_search 는 텍스트만 주기 때문이다.
#    끄면 카드가 글자만 남는다 (동작에는 문제 없다).
HOTEL_THUMBNAILS=true
HOTEL_THUMBNAIL_TIMEOUT_SECONDS=4
# 예약 페이지는 200~400KB 다. 이미지 주소는 앞쪽에 있으므로 다 읽을 이유가 없다.
HOTEL_THUMBNAIL_MAX_KB=512

# 관광지: 긁어올 예약 페이지가 없어서 위키백과 API 에서 찾는다 (키 불필요·무료).
# ⚠️ 전부 채워지지는 않는다 — 실측 87%. 나머지는 그 줄만 사진 없이 나간다.
ATTRACTION_IMAGES=true
# 여러 곳을 동시에 찾는다. 하나가 늘어지면 카드 전체가 그만큼 늦으므로 짧게 끊는다.
ATTRACTION_IMAGE_TIMEOUT_SECONDS=3

# --------------------------------------------------------------------------
# 구글 Places — 관광지의 **사실 데이터** (주소·좌표·평점·운영시간)
#
# 왜 모델에게 안 묻나: 이런 건 장소마다 정답이 하나인 사실이고, LLM 은 모르는 것도
# 그럴듯하게 채운다. 틀린 운영시간은 사용자를 헛걸음시킨다 — 사진이 없는 것과
# 차원이 다른 실패다. 구조화 API 는 모르면 그 필드를 아예 안 준다.
#
# ⚠️ 비어 있으면 이 기능이 통째로 꺼진다. 관광지 검색은 지금처럼 그대로 돈다 —
#    주소·좌표·평점 칸만 null 로 남는다.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=3

# 상위 몇 곳까지 조회할지. 도시 1곳당 이 횟수만큼 부르고 결과는 30일 캐시된다.
# 20(저장하는 전부)이면 한 달에 도시 500곳까지가 Essentials 무료 한도(월 10,000회) 안이다.
GOOGLE_PLACES_LIMIT=20

# 평점·리뷰수·운영시간·홈페이지까지 받을지.
# ⚠️ **더 비싼 티어**(Enterprise)라 무료 한도가 훨씬 작다. 켤 거면 현재 요금표에서
#    한도를 확인하고 GOOGLE_PLACES_LIMIT 을 같이 낮춰라.
# ⚠️ 구글 약관이 place_id 외 콘텐츠의 장기 보관을 제한한다. 이 값들을 노출 스냅샷에
#    영구 보관하는 게 걸릴 수 있으니 켜기 전에 약관을 확인하라.
GOOGLE_PLACES_RATINGS=false

# ==========================================================================
# 9. 항공권 출발지
# ==========================================================================
# "오사카 항공권" 처럼 출발지를 안 말하는 게 보통이다. 되묻는 대신 여기서 출발한다고
# 보고, **카드 아래 안내에 "서울 출발 기준" 을 적는다** — 부산에서 가려던 사람이
# 고쳐 말할 유일한 단서다. 조용히 추측하면 잘못된 노선의 가격을 믿게 된다.
FLIGHT_DEFAULT_ORIGIN_NAME=서울
FLIGHT_DEFAULT_ORIGIN_CODE=ICN
