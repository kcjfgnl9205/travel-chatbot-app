[Unit]
Description=travel-chatbot-app 자동 배포 (origin/main 확인 후 변경 시에만 실행)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/travel-chatbot-app
ExecStart=/bin/bash /home/ubuntu/travel-chatbot-app/deploy/auto-deploy.sh
# 빌드가 오래 걸려도 타이머가 중복 실행하지 않도록 넉넉히 준다.
TimeoutStartSec=1800
